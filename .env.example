# Copy to .env and fill in. Never commit .env.
# The demo login below is bundled so a fresh clone works. Change ATTORNEY_PASSWORD and JWT_SECRET before hosting publicly.

# --- Anthropic (Claude) ---
# REQUIRED for "Ask the case" only (everything else runs without it). Get one at https://console.anthropic.com — never commit it.
ANTHROPIC_API_KEY=
# Model routing (defaults shown)
MODEL_MAIN=claude-opus-5-5
MODEL_FAST=claude-haiku-4-5

# --- Clio Manage (READ-ONLY) — register an app at https://app.clio.com/settings/developer_applications
# Only needed to sync from your own Clio account (not for the bundled demo data). Add your own — never commit them.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://127.0.0.1:8000/auth/clio/callback
CLIO_BASE_URL=https://app.clio.com

# --- App auth ---
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ATTORNEY_EMAIL=attorney@casepulse.test
ATTORNEY_PASSWORD=nv257RW0ATZ1
ATTORNEY_NAME=Firm Attorney
FIRM_NAME=Your Firm

# --- Optional ---
RESEND_API_KEY=
INVITE_FROM_EMAIL=
AI_BUDGET_PER_MATTER_USD=5
EMBED_MODEL=BAAI/bge-base-en-v1.5

# --- Storage / URLs ---
DB_PATH=data/casepulse.db
DATA_DIR=data
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
