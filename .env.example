# Copy to .env and fill in. Never commit .env.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Model routing (defaults shown)
MODEL_MAIN=claude-opus-5-5
MODEL_FAST=claude-haiku-4-5

# --- Clio Manage (READ-ONLY) — register an app at https://app.clio.com/settings/developer_applications
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://127.0.0.1:8000/auth/clio/callback
CLIO_BASE_URL=https://app.clio.com

# --- App auth ---
JWT_SECRET=change-me-to-a-long-random-string
ATTORNEY_EMAIL=attorney@firm.test
ATTORNEY_PASSWORD=change-me
ATTORNEY_NAME=Firm Attorney
FIRM_NAME=Your Firm

# --- Optional ---
RESEND_API_KEY=
INVITE_FROM_EMAIL=
AI_BUDGET_PER_MATTER_USD=5
EMBED_MODEL=BAAI/bge-base-en-v1.5

# --- Storage / URLs ---
DB_PATH=data/casepulse.db
DATA_DIR=data
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
